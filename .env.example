# Backend runtime
PYTHON_VERSION=3.11.9
DEPLOY_MODE=local
DISABLE_LOCAL_EMBEDDING=true

# AI
AI_PROVIDER=cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
BATCH_TRIAGE_ENABLED=false
BATCH_EXTRACTION_PROVIDER=cerebras
AI_TIMEOUT_SECONDS=8
AI_REPLY_GENERATION_ENABLED=false
AI_REPLY_TIMEOUT_SECONDS=20
AI_DOCTOR_SCORING_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-m3

# Azure SQL
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Voice gateway
VOICE_ENABLED=false
VOICE_GATEWAY_URL=http://localhost:8000
VOICE_GATEWAY_KEY=
VOICE_GATEWAY_IS_NGROK=false
VOICE_DEFAULT_LANG=taiwanese
VOICE_TIMEOUT=60
VOICE_USE_FIXED_CACHE=false
